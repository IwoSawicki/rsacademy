---
/**
 * Ladebildschirm: dunkle Fläche, der Firmenname erscheint Wort für Wort
 * (Blur + Translate von unten), danach fährt die Fläche weg.
 * Original: Wörter starten mit opacity .001, blur(5px), translateY(270px).
 */
const words = ["Rescue", "&", "Safety", "Academy", "AG"];
---

<div
  id="preloader"
  class="fixed inset-0 z-[100] flex items-center justify-center bg-ink px-5"
>
  <p class="t-display flex flex-wrap justify-center gap-x-[0.25em] text-white">
    {
      words.map((word, i) => (
        <span
          class="inline-block opacity-0 blur-[5px] will-change-transform"
          style={`transform:translateY(270px);transition:opacity .9s cubic-bezier(.16,1,.3,1) ${i * 80}ms, transform .9s cubic-bezier(.16,1,.3,1) ${i * 80}ms, filter .9s cubic-bezier(.16,1,.3,1) ${i * 80}ms`}
          data-preload-word
        >
          {word}
        </span>
      ))
    }
  </p>
</div>

<script>
  const root = document.getElementById("preloader");
  const words = document.querySelectorAll<HTMLElement>("[data-preload-word]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const finish = () => {
    if (!root) return;
    root.style.transition = "transform .9s cubic-bezier(.76,0,.24,1)";
    root.style.transform = "translateY(-100%)";
    document.body.style.overflow = "";
    window.setTimeout(() => root.remove(), 1000);
    document.dispatchEvent(new CustomEvent("preloader:done"));
  };

  if (reduced) {
    root?.remove();
    document.dispatchEvent(new CustomEvent("preloader:done"));
  } else {
    document.body.style.overflow = "hidden";
    requestAnimationFrame(() => {
      words.forEach((word) => {
        word.style.opacity = "1";
        word.style.filter = "blur(0px)";
        word.style.transform = "translateY(0)";
      });
    });
    window.setTimeout(finish, 1700);
  }
</script>
