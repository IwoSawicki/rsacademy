---
/**
 * Ladebildschirm. Werte aus dem appear-animations-JSON des Clones:
 * Der Textblock (appear-id 1b4e3p4) fährt von y=640 hoch, opacity .001 -> 1,
 * als tween über 2.1s mit cubic-bezier(0.56, 0.22, 0.05, 0.99).
 * Die einzelnen Wörter starten zusätzlich mit blur(5px) und y=270.
 * Der Hero (appear-id n6szvs) folgt mit 1.85s Verzögerung.
 */
const words = ["Rescue", "&", "Safety", "Academy", "AG"];
---

<div
  id="preloader"
  class="fixed inset-0 z-[100] flex items-center justify-center overflow-hidden bg-ink px-5"
>
  <p
    class="t-display flex flex-wrap justify-center gap-x-[0.25em] text-white opacity-0 will-change-transform"
    style="transform:translateY(640px);transition:opacity 2.1s var(--ease-preloader),transform 2.1s var(--ease-preloader)"
    data-preload-block
  >
    {
      words.map((word, i) => (
        <span
          class="inline-block opacity-0 blur-[5px] will-change-transform"
          style={`transform:translateY(270px);transition:opacity .9s var(--ease-preloader) ${i * 70}ms, transform .9s var(--ease-preloader) ${i * 70}ms, filter .9s var(--ease-preloader) ${i * 70}ms`}
          data-preload-word
        >
          {word}
        </span>
      ))
    }
  </p>
</div>

<script>
  const root = document.getElementById("preloader");
  const block = document.querySelector<HTMLElement>("[data-preload-block]");
  const words = document.querySelectorAll<HTMLElement>("[data-preload-word]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const done = () => document.dispatchEvent(new CustomEvent("preloader:done"));

  const finish = () => {
    if (!root) return;
    root.style.transition = "transform .9s cubic-bezier(.76,0,.24,1)";
    root.style.transform = "translateY(-100%)";
    document.body.style.overflow = "";
    window.setTimeout(() => root.remove(), 1000);
    done();
  };

  if (reduced) {
    root?.remove();
    done();
  } else {
    document.body.style.overflow = "hidden";
    requestAnimationFrame(() => {
      if (block) {
        block.style.opacity = "1";
        block.style.transform = "translateY(0)";
      }
      words.forEach((word) => {
        word.style.opacity = "1";
        word.style.filter = "blur(0px)";
        word.style.transform = "translateY(0)";
      });
    });
    // Der Hero startet im Original bei 1.85s
    window.setTimeout(finish, 1850);
  }
</script>
