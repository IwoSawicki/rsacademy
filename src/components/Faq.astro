---
import { faq } from "../data/site";

/**
 * FAQ. Maße aus dem Clone:
 *
 *   Karte    Radius 14px, weiß, 4px Abstand zur nächsten, overflow hidden
 *   Kopf     Innenabstand 26px, Inhalt auf space-between
 *   Frage    Inter 18px/500, Zeilenhöhe 1.3em, Laufweite -0.04em, #0a0a0a
 *   Symbol   18px, dunkler Kreis mit weißem Plus, 16px Abstand links
 *   Antwort  Inter 15px/500, Zeilenhöhe 1.4em, rgba(10,10,10,.6),
 *            Innenabstand 0 26px 26px
 */
---

<section class="section-x flex w-full items-center justify-center gap-1">
  <div
    class="container-wide flex flex-col items-start justify-center gap-10 tablet:flex-row tablet:gap-1"
    data-measure="faq-container"
  >
    <div
      class="flex w-full flex-col items-start gap-[18px] tablet:flex-1 tablet:gap-[30px]"
      data-measure="faq-heading"
    >
      <h2 class="t-display w-full" data-reveal="up">FAQ</h2>
      <p class="t-body w-full max-w-[380px] opacity-60" data-reveal="up">
        Häufig gestellte Fragen.
      </p>
    </div>

    <ul class="flex w-full flex-col gap-1 tablet:flex-1">
      {
        faq.map((item) => (
          <li
            class="overflow-hidden rounded-[14px] bg-white"
            data-reveal="up"
            data-measure="faq-item"
          >
            <button
              type="button"
              class="group flex w-full cursor-pointer items-center justify-between p-[26px] text-left"
              data-accordion
              aria-expanded="false"
            >
              <span
                class="text-[18px] leading-[1.3em] font-medium text-ink"
                style="letter-spacing:-0.04em"
              >
                {item.q}
              </span>

              {/* Dunkler Kreis mit weißem Plus, dreht beim Öffnen auf ein Kreuz */}
              <span
                class="ml-4 flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-full bg-ink transition-transform duration-[450ms] ease-[var(--ease-framer)] group-aria-expanded:rotate-45"
                aria-hidden="true"
              >
                <span class="relative block h-[8px] w-[8px]">
                  <span class="absolute top-1/2 left-0 h-[1.5px] w-full -translate-y-1/2 rounded-full bg-white" />
                  <span class="absolute top-0 left-1/2 h-full w-[1.5px] -translate-x-1/2 rounded-full bg-white" />
                </span>
              </span>
            </button>

            <div
              class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-[450ms] ease-[var(--ease-framer)]"
              data-accordion-panel
            >
              <div class="overflow-hidden">
                <p
                  class="px-[26px] pb-[26px] text-[15px] leading-[1.4em] font-medium whitespace-pre-line text-ink/60"
                  style="letter-spacing:-0.04em"
                >
                  {item.a}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
