---
import { faq } from "../data/site";
---

<section class="section-x flex w-full items-center justify-center gap-1">
  <div
    class="container-wide flex flex-col items-start justify-center gap-10 desktop:flex-row desktop:gap-1"
  >
    <!-- Heading -->
    <div class="flex w-full flex-col items-start gap-[18px] desktop:flex-1 desktop:gap-[30px]">
      <h2 class="t-display w-full" data-reveal="up">FAQ</h2>
      <p class="t-body w-full max-w-[380px] opacity-60" data-reveal="up">
        Häufig gestellte Fragen.
      </p>
    </div>

    <!-- Fragen -->
    <ul class="flex w-full flex-col desktop:flex-1">
      {
        faq.map((item) => (
          <li class="border-b border-ink/10" data-reveal="up">
            <button
              type="button"
              class="group flex w-full cursor-pointer items-center justify-between gap-5 py-6 text-left"
              data-accordion
              aria-expanded="false"
            >
              <span class="t-subhead flex-1">{item.q}</span>
              <span
                class="relative block h-[18px] w-[18px] shrink-0 transition-transform duration-[450ms] ease-[var(--ease-framer)] group-aria-expanded:rotate-45"
                aria-hidden="true"
              >
                <span class="absolute top-1/2 left-0 h-[1.5px] w-full -translate-y-1/2 bg-ink" />
                <span class="absolute top-0 left-1/2 h-full w-[1.5px] -translate-x-1/2 bg-ink" />
              </span>
            </button>
            <div
              class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-[450ms] ease-[var(--ease-framer)]"
              data-accordion-panel
            >
              <div class="overflow-hidden">
                <p class="t-body-lg pb-6 opacity-70">{item.a}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
