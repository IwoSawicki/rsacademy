---
import { contact, images } from "../data/site";
import ContactCard from "./ContactCard.astro";

/**
 * Kontakt. Links die Formularkarte (450px, Innenabstand 40px, Abstände 30px),
 * rechts eine Bildfläche mit weißer Überschrift „Jetzt Kontaktieren" (54px,
 * Zeilenhöhe 92%) und zwei weißen Karten (Radius 18px) mit Bezeichnung
 * (18px) und Wert (26px).
 */
const fields = [
  { name: "name", label: "Ihr Name*", type: "text", placeholder: "Max Müller", required: true },
  { name: "email", label: "E-mail*", type: "email", placeholder: "max@mueller.com", required: true },
  { name: "phone", label: "Telefon*", type: "tel", placeholder: "+41 123 456 789", required: true },
];

const items = [
  {
    label: "E-Mail",
    value: contact.mailKurs,
    href: `mailto:${contact.mailKurs}`,
    icon: "mail" as const,
  },
  {
    label: "Telefon",
    value: contact.phone,
    href: contact.phoneHref,
    icon: "phone" as const,
  },
];
---

<section id="kontakt" class="section-x flex w-full items-start justify-center gap-1">
  <div
    class="container-wide flex flex-col items-start gap-[60px] tablet:flex-row tablet:gap-1"
    data-measure="kontakt-container"
  >
    <!-- Formular. Darunter liegt im Original eine 80px hohe Freifläche,
         die die Höhe der Spalte bestimmt. -->
    <div class="flex w-full flex-col items-start gap-1 tablet:flex-1">
      <div
        class="flex w-full flex-col items-start gap-[30px] overflow-hidden rounded-[18px] bg-white p-10 tablet:max-w-[418px] desktop:max-w-[546px]"
        data-measure="kontakt-form"
        data-reveal="up"
      >
        <div class="flex w-full flex-col items-start gap-3">
          <p
            class="text-[20px] leading-[110%] font-semibold text-ink"
            style="letter-spacing:-0.04em"
          >
            Rescue &amp; Safety Academy AG
          </p>
          <h2 class="t-h2 w-full text-ink-soft">Noch Fragen?</h2>
        </div>

        <form class="flex w-full flex-col gap-[30px]" data-contact-form>
          <div class="flex w-full flex-col gap-4">
          {
            fields.map((field) => (
              <label class="flex w-full flex-col gap-3">
                <span class="t-caption opacity-60">{field.label}</span>
                <input
                  type={field.type}
                  name={field.name}
                  placeholder={field.placeholder}
                  required={field.required}
                  class="h-[58px] w-full rounded-[10px] bg-surface py-3 pr-3 pl-4 text-[16px] outline-none transition-shadow duration-300 placeholder:opacity-40 focus:ring-1 focus:ring-ink/20"
                />
              </label>
            ))
          }

            <label class="flex w-full flex-col gap-3">
              <span class="t-caption opacity-60">Nachricht</span>
              <textarea
                name="message"
                placeholder="Liebes RS Academy Team, ..."
                class="h-[100px] w-full resize-none rounded-[10px] bg-surface py-3 pr-3 pl-4 text-[16px] outline-none transition-shadow duration-300 placeholder:opacity-40 focus:ring-1 focus:ring-ink/20"
              ></textarea>
            </label>
          </div>

          <button
            type="submit"
            class="flex h-[58px] w-full cursor-pointer items-center justify-center rounded-pill bg-ink p-[18px] transition-opacity duration-300 hover:opacity-85"
          >
            <span class="t-label text-white">Nachricht verschicken</span>
          </button>

          <p class="t-caption opacity-60">
            Durch das Abschicken erklären Sie sich mit unserer <a
              href="/datenschutz"
              class="underline underline-offset-2">Datenschutzerklärung</a
            > einverstanden
          </p>
        </form>
      </div>
      <div class="hidden h-[80px] w-full tablet:block" aria-hidden="true"></div>
    </div>

    <!-- Bildfläche mit Kontaktdaten -->
    <div
      class="relative flex w-full flex-col items-start gap-[60px] overflow-hidden rounded-[18px] tablet:flex-1 tablet:gap-10 tablet:self-start tablet:p-10"
      data-reveal="up"
      style="transition-delay:90ms"
    >
      <div class="absolute inset-0 -z-10 bg-ink" aria-hidden="true">
        <img
          src={images.kontaktBg}
          alt=""
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>

      <h2
        class="text-[38px] leading-[92%] font-semibold text-white tablet:text-[54px]"
        style="letter-spacing:-0.06em"
      >
        Jetzt<br />Kontaktieren
      </h2>

      <div class="flex w-full flex-col gap-11">
        <div class="flex w-full flex-col gap-1">
          {
            items.map((item) => (
              <ContactCard
                label={item.label}
                value={item.value}
                href={item.href}
                icon={item.icon}
              />
            ))
          }
        </div>
        <span class="block h-px w-full bg-white/30" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>
