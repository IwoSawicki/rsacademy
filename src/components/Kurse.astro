---
import { kurse, contact } from "../data/site";
import RollButton from "./RollButton.astro";
---

<section class="section-x flex w-full flex-col items-center gap-[70px]">
  <div
    class="container-wide flex flex-col items-center gap-[30px] tablet:gap-[60px] desktop:gap-[90px]"
    data-measure="kurse-container"
  >
    <!-- Top -->
    <div class="flex w-full flex-col items-start gap-4 desktop:gap-1">
      <h2 class="t-display w-full" data-reveal="up">Kursangebot</h2>
    </div>

    <!-- Kartenraster, 1000px breit und zentriert -->
    <ul
      class="container-narrow flex flex-col items-center gap-[10px] tablet:grid tablet:grid-cols-2 tablet:gap-5"
      data-measure="kurse-grid"
    >
      {
        kurse.map((kurs, i) => (
          <li class="w-full" data-reveal="up" style={`transition-delay:${(i % 2) * 90}ms`}>
            <a
              href="/kurse"
              class="group flex w-full cursor-pointer flex-col items-center gap-1"
            >
              <!-- Project header -->
              <div class="box-border flex h-[58px] w-full items-center gap-4 rounded-card bg-white px-5 py-[18px] tablet:gap-5 tablet:px-6" data-measure="kurs-header">
                <p class="t-label flex-1 text-ink">
                  <span class={kurs.titlePhone ? "hidden tablet:inline" : undefined}>
                    {kurs.title}
                  </span>
                  {kurs.titlePhone && <span class="tablet:hidden">{kurs.titlePhone}</span>}
                </p>
                <span class="flex h-[30px] w-[30px] shrink-0 items-center justify-center">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    class="-rotate-40 text-ink transition-transform duration-[450ms] ease-[var(--ease-framer)] group-hover:rotate-0"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </div>

              <!-- Background + Image -->
              <div class="relative aspect-[1.36585] w-full overflow-hidden rounded-card bg-white">
                <div class="absolute inset-1 overflow-hidden rounded-[16px] transition-[inset] duration-[450ms] ease-[var(--ease-framer)] group-hover:inset-0">
                  <img
                    src={kurs.image}
                    alt=""
                    width="600"
                    height="400"
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                  <div
                    class="absolute inset-0 bg-ink/15 transition-opacity duration-500 group-hover:opacity-0"
                    aria-hidden="true"
                  />
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex w-full flex-wrap items-center gap-3" data-reveal="up">
      <RollButton label="Kontaktformular" href="/kontakt" />
      <RollButton
        label={contact.phoneLabel}
        href={contact.phoneHref}
        variant="light"
        class="border border-ink/10"
      />
    </div>
  </div>
</section>
