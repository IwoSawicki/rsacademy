---
import { kurse, contact } from "../data/site";
import RollButton from "./RollButton.astro";
---

<section class="section-x flex w-full flex-col items-center gap-[70px]">
  <div class="container-wide flex flex-col gap-10">
    <h2 class="t-h2" data-reveal="up">Kursangebot</h2>

    <ul
      class="container-narrow mx-auto flex flex-col gap-[10px] tablet:grid tablet:grid-cols-2 tablet:gap-5"
    >
      {
        kurse.map((kurs, i) => (
          <li data-reveal="up" style={`transition-delay:${(i % 2) * 90}ms`}>
            <a
              href="/kurse"
              class="group block overflow-hidden rounded-card bg-white transition-opacity duration-500 hover:opacity-100"
            >
              <div class="flex min-h-[58px] items-center justify-between gap-5 px-6 py-[18px]">
                <p class="t-label text-ink">{kurs.title}</p>
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  class="shrink-0 -rotate-40 text-ink transition-transform duration-[450ms] ease-[var(--ease-framer)] group-hover:rotate-0"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </div>

              <div class="relative aspect-[1.36585] w-full">
                <div class="absolute inset-1 overflow-hidden rounded-[16px] transition-[inset] duration-[450ms] ease-[var(--ease-framer)] group-hover:inset-0">
                  <img
                    src={kurs.image}
                    alt=""
                    width="600"
                    height="400"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-[600ms] ease-[var(--ease-framer)] group-hover:scale-105"
                  />
                  <div
                    class="absolute inset-0 bg-ink/15 transition-opacity duration-500 group-hover:opacity-0"
                    aria-hidden="true"
                  />
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex flex-wrap items-center gap-3" data-reveal="up">
      <RollButton label="Kontaktformular" href="/kontakt" />
      <RollButton
        label={contact.phoneLabel}
        href={contact.phoneHref}
        variant="light"
        class="border border-ink/10"
      />
    </div>
  </div>
</section>
