---
import { reviews } from "../data/site";
import StarRating from "./StarRating.astro";
---

<div
  class="flex w-full max-w-[501px] flex-col gap-[10px]"
  data-review-slider
  data-reveal="up"
>
  <!-- Karten, im Raster übereinandergelegt: Höhe richtet sich nach der längsten -->
  <div class="grid">
    {
      reviews.map((review, i) => (
        <figure
          class:list={[
            "col-start-1 row-start-1 flex w-full items-center gap-[14px] rounded-[8px] bg-white/95 p-4 backdrop-blur-[80px] shadow-[0px_30px_18px_-20px_rgba(0,0,0,0.16)] transition-opacity duration-500 ease-[var(--ease-framer)]",
            i === 0 ? "opacity-100" : "pointer-events-none opacity-0",
          ]}
          data-review-slide
          aria-hidden={i !== 0}
        >
          <div class="flex w-full flex-col gap-2">
            <div class="flex items-center gap-[5px]">
              <img
                src={review.image}
                alt=""
                width="18"
                height="18"
                loading="lazy"
                class="h-[18px] w-[18px] shrink-0 rounded-[4px] object-cover"
              />
              <StarRating size={13} />
            </div>
            <figcaption class="flex flex-col gap-[6px]">
              <p class="t-caption text-ink-soft">{review.text}</p>
              <p class="t-caption font-semibold text-ink">{review.name}</p>
            </figcaption>
          </div>
        </figure>
      ))
    }
  </div>

  <!-- Steuerung -->
  <div class="flex items-center justify-center gap-[22px]">
    <button
      type="button"
      class="text-white opacity-30 transition-opacity duration-300 hover:opacity-100 disabled:pointer-events-none disabled:opacity-30"
      data-review-prev
      aria-label="Vorherige Bewertung"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M19 12H5M11 18l-6-6 6-6" />
      </svg>
    </button>

    <div class="flex items-center gap-[6px]">
      {
        reviews.map((_, i) => (
          <span
            class:list={[
              "h-[6px] w-[6px] rounded-full bg-white transition-opacity duration-300",
              i === 0 ? "opacity-100" : "opacity-30",
            ]}
            data-review-dot
          />
        ))
      }
    </div>

    <button
      type="button"
      class="text-white opacity-100 transition-opacity duration-300 hover:opacity-70 disabled:pointer-events-none disabled:opacity-30"
      data-review-next
      aria-label="Nächste Bewertung"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </button>
  </div>
</div>
