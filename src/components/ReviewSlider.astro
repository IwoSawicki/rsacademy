---
import { reviews } from "../data/site";

/**
 * Bewertungs-Stack im Hero.
 * Karte 463px breit, Wrapper 501px inkl. 22px Abstand zur senkrechten
 * Steuerung rechts (Pfeil hoch, drei Bullets untereinander, Pfeil runter).
 * Die drei Karten liegen gestaffelt übereinander (scale 1 / .95 / .9,
 * Versatz 0 / 14 / 28px) und rotieren automatisch durch.
 */
---

<div
  class="flex w-full max-w-[501px] items-center gap-[22px]"
  data-measure="hero-slider"
  data-review-stack
  data-reveal="up"
>
  <!-- Kartenstapel -->
  <div class="relative flex flex-1 flex-col items-center">
    {
      reviews.map((review) => (
        <figure
          class="flex w-full origin-bottom items-center gap-[14px] overflow-hidden rounded-[8px] bg-white p-4 shadow-[0px_30px_18px_-20px_rgba(0,0,0,0.16)] backdrop-blur-[80px] transition-[transform,bottom] duration-[700ms] ease-[var(--ease-framer)]"
          data-review-card
          data-measure="hero-card"
        >
          <div class="flex flex-1 flex-col items-start gap-2">
            <div class="flex w-full items-center gap-[5px]">
              <img
                src={review.image}
                alt=""
                width="18"
                height="18"
                loading="lazy"
                class="h-[18px] w-[18px] shrink-0 rounded-[4px] object-cover"
              />
              <div class="flex items-center">
                {Array.from({ length: 5 }).map(() => (
                  <svg width="14" height="15" viewBox="0 0 24 24" fill="rgb(255, 234, 0)" aria-hidden="true">
                    <path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3.1-5.8 3.1 1.1-6.5L2.6 9.3l6.5-.9L12 2.5z" />
                  </svg>
                ))}
              </div>
            </div>

            <figcaption class="flex w-full flex-col items-start gap-[6px]">
              <p class="font-figtree text-[12px] leading-[150%] font-medium text-black opacity-60">
                {review.name}
              </p>
              <p class="font-figtree text-[14px] leading-[150%] font-medium text-black opacity-80">
                {review.text}
              </p>
            </figcaption>
          </div>
        </figure>
      ))
    }
  </div>

  <!-- Senkrechte Steuerung -->
  <div class="flex w-min flex-col items-center gap-[10px]">
    <button
      type="button"
      class="cursor-pointer text-white opacity-30 transition-opacity duration-300 hover:opacity-100"
      data-review-prev
      aria-label="Vorherige Bewertung"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>

    <div class="flex w-min flex-col items-center gap-[8px]">
      {
        reviews.map((_, i) => (
          <span
            class:list={[
              "h-[6px] w-[6px] rounded-full bg-white transition-opacity duration-300",
              i === 0 ? "opacity-100" : "opacity-30",
            ]}
            data-review-dot
          />
        ))
      }
    </div>

    <button
      type="button"
      class="cursor-pointer text-white transition-opacity duration-300 hover:opacity-70"
      data-review-next
      aria-label="Nächste Bewertung"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M12 5v14M5 12l7 7 7-7" />
      </svg>
    </button>
  </div>
</div>
