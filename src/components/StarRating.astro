---
interface Props {
  count?: number;
  size?: number;
}
const { count = 5, size = 14 } = Astro.props;
---

<div class="flex items-center gap-[2px]">
  {
    Array.from({ length: count }).map(() => (
      <svg
        width={size}
        height={size}
        viewBox="0 0 24 24"
        fill="var(--color-star)"
        aria-hidden="true"
      >
        <path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3.1-5.8 3.1 1.1-6.5L2.6 9.3l6.5-.9L12 2.5z" />
      </svg>
    ))
  }
</div>
