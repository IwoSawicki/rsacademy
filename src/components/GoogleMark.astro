---
/**
 * Google-Logo in der Bewertungskarte. Im Original liegt dort ein 18px-Bild
 * mit 4px Radius (`vDdcKoFC0lRIa2ByWfOoAqbDU.png`) — bis die Originaldatei
 * vorliegt steht hier das Zeichen als SVG.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className = "", ...rest } = Astro.props;
---

<svg
  class:list={["shrink-0", className]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  role="img"
  aria-label="Google"
  {...rest}
>
  <path
    fill="#4285F4"
    d="M45.1 24.5c0-1.6-.1-3.2-.4-4.7H24v8.9h11.8a10 10 0 0 1-4.4 6.6v5.5h7.1c4.2-3.8 6.6-9.5 6.6-16.3z"
  ></path>
  <path
    fill="#34A853"
    d="M24 46c6 0 11-2 14.6-5.3l-7.1-5.5c-2 1.3-4.5 2.1-7.5 2.1-5.8 0-10.6-3.9-12.4-9.1H4.3v5.7A22 22 0 0 0 24 46z"
  ></path>
  <path
    fill="#FBBC05"
    d="M11.6 28.2a13.2 13.2 0 0 1 0-8.4v-5.7H4.3a22 22 0 0 0 0 19.8l7.3-5.7z"
  ></path>
  <path
    fill="#EA4335"
    d="M24 9.5c3.3 0 6.2 1.1 8.5 3.3l6.3-6.3C35 2.9 30 1 24 1A22 22 0 0 0 4.3 14.1l7.3 5.7C13.4 13.4 18.2 9.5 24 9.5z"
  ></path>
</svg>
