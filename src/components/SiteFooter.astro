---
import { nav, legal, contact } from "../data/site";
import PlusIcon from "./PlusIcon.astro";
import FooterContact from "./FooterContact.astro";
import FitText from "./FitText.astro";

/**
 * Fußbereich. Maße aus dem Clone:
 *
 *   Top     Innenabstand 100px 36px
 *   Links   zwei Spalten, Abstand 4px
 *   Spalte1 rechts 80px Abstand, Abstand 80px, Kontaktblock 28px
 *   Spalte2 Abstand 100px — oben Navigation und Soziales nebeneinander,
 *           darunter der große Schriftzug als Fit-Text
 *   Bottom  Innenabstand 42px 36px, drei gleich breite Spalten
 *
 * Schriftgrößen: Gruppentitel 14px/500, Linkeinträge 22px/500,
 * Telefon und E-Mail 34px/600.
 */
const social = [
  { label: "Linked In", href: "https://www.linkedin.com" },
  { label: "Google Maps", href: "https://maps.google.com" },
];

/**
 * Rückverweis auf die Agentur. Die UTM-Parameter machen in der Statistik
 * sichtbar, wie viele Besuche über diesen Link kommen.
 */
const STUDIO_URL =
  "https://stolz-marketing.de/?utm_source=rsacademy.ch&utm_medium=referral&utm_campaign=footer-credit";

const linkClass =
  "text-[22px] leading-[1.2em] font-medium text-ink transition-opacity duration-300 hover:opacity-60";
const titleClass = "text-[14px] leading-[1.3em] font-medium text-ink opacity-60";
---

<footer class="w-full overflow-hidden bg-surface">
  <!-- Top -->
  <div
    class="flex w-full flex-col items-center gap-10 bg-surface px-5 py-[50px] tablet:gap-[70px] tablet:px-[30px] tablet:pt-[140px] tablet:pb-[100px] desktop:gap-20 desktop:px-9 desktop:py-[100px]"
    data-measure="footer-top"
  >
    <div
      class="container-wide flex flex-col items-start gap-10 tablet:grid tablet:grid-cols-2 tablet:gap-1"
      data-measure="footer-links"
    >
      <!-- Spalte 1: Kontakt -->
      <div
        class="flex w-full flex-col items-start gap-10 tablet:gap-[70px] tablet:pr-[30px] desktop:gap-20 desktop:pr-20"
      >
        <PlusIcon size={16} bar={2} color="#0a0a0a" class="opacity-30" />

        <div class="flex w-full flex-col items-start gap-7">
          <FooterContact href={contact.phoneHref} label={contact.phone} />
          <FooterContact
            href={`mailto:${contact.mailKurs}`}
            label={contact.mailKurs}
          />
        </div>
      </div>

      <!-- Spalte 2: Linklisten und Schriftzug -->
      <div
        class="flex w-full flex-col items-start gap-10 tablet:gap-[90px] desktop:gap-[100px]"
      >
        <div class="flex w-full flex-row gap-1">
          <!-- Navigation -->
          <nav
            class="flex w-full flex-1 flex-col items-start gap-10 desktop:gap-20"
          >
            <PlusIcon size={16} bar={2} color="#0a0a0a" class="opacity-30" />
            <div class="flex w-full flex-col items-start gap-4">
              <p class={titleClass}>Navigation</p>
              <ul class="flex flex-col gap-[10px]">
                {
                  nav.map((item) => (
                    <li>
                      <a href={item.href} class={linkClass}>
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </nav>

          <!-- Soziales und Rechtliches -->
          <div
            class="flex w-full flex-1 flex-col items-start gap-10 desktop:gap-[60px]"
          >
            <PlusIcon size={16} bar={2} color="#0a0a0a" class="opacity-30" />

            <div class="flex w-full flex-col items-start gap-4">
              <p class={titleClass}>Soziale Netzwerke</p>
              <ul class="flex flex-col gap-[10px]">
                {
                  social.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`${linkClass} group inline-flex items-center gap-2`}
                      >
                        {item.label}
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          class="transition-transform duration-300 group-hover:translate-x-[2px] group-hover:-translate-y-[2px]"
                          aria-hidden="true"
                        >
                          <path d="M7 17L17 7M7 7h10v10" />
                        </svg>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="flex w-full flex-col items-start gap-4">
              <p class={titleClass}>Rechtliches</p>
              <ul class="flex flex-col gap-[10px]">
                {
                  legal.map((item) => (
                    <li>
                      <a href={item.href} class={linkClass}>
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <!-- Schriftzug als Fit-Text, wie im Original -->
        <div class="w-full pb-[10px]">
          <FitText
            viewBox="0 0 561.7901981016153 192"
            fontSize={79.83663502692025}
            color="#0a0a0a"
          >
            Rescue &amp; Safety{"\n"}Academy AG
          </FitText>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom: dunkler Verlauf über die volle Breite, drei gleiche Spalten -->
  <div
    class="relative z-[3] w-full px-6 py-10 tablet:px-[30px] tablet:py-[42px] desktop:px-9"
    style="background:linear-gradient(90deg,#0a0a0a 0%,#050505 85%)"
  >
    <div
      class="container-wide flex flex-col gap-4 tablet:grid tablet:grid-cols-3 tablet:gap-1"
    >
      <p class="t-small text-white">© 2026 Search &amp; Rescue Academy AG</p>

      <div class="flex flex-wrap gap-[18px] tablet:justify-center">
        {
          legal.map((item) => (
            <a
              href={item.href}
              class="t-small text-white transition-opacity duration-300 hover:opacity-70"
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <p class="t-small text-white tablet:text-right">
        Mit ❤️ erstellt von <a
          href={STUDIO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2">Stolz Marketing</a
        >
      </p>
    </div>
  </div>
</footer>
