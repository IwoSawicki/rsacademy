---
/**
 * Kontaktzeile im Footer: dunkler Kreis mit weißem Plus (18px), 7px Abstand,
 * dann der Text in Inter 34px/600 (Laufweite -0.05em, Zeilenhöhe 110%,
 * Farbe #090909) mit einer 2px-Linie darunter.
 */
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a href={href} class="group flex w-max items-center gap-[7px]">
  <span
    class="relative flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-[50px] bg-ink"
    aria-hidden="true"
  >
    <span class="relative block h-[8px] w-[8px]">
      <span class="absolute top-1/2 left-0 h-[2px] w-full -translate-y-1/2 bg-white"></span>
      <span class="absolute top-0 left-1/2 h-full w-[2px] -translate-x-1/2 bg-white"></span>
    </span>
  </span>

  <span class="relative flex w-max items-center gap-[10px]">
    <span
      class="text-[26px] leading-[110%] font-semibold whitespace-pre text-ink-soft transition-opacity duration-300 group-hover:opacity-60 desktop:text-[34px]"
      style="letter-spacing:-0.05em">{label}</span
    >
    <span
      class="absolute -bottom-[6px] left-0 h-[2px] w-full bg-ink"
      aria-hidden="true"></span>
  </span>
</a>
