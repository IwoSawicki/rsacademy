---
import { images, contact } from "../data/site";
import PlusIcon from "./PlusIcon.astro";
import RollButton from "./RollButton.astro";

const paragraphs = [
  "Ob Sicherheit bei der Höhenarbeit, Ausbildung von Sicherheitsbeauftragten oder IPAF Zertifizierungen - Wir unterstützen Sie mit Rat und Tat!",
  "Unser Experten-Team verfügt über langjährige Erfahrung in der Praxis und dank stetigen Aus- und Weiterbildungen bleiben wir immer auf dem neusten Stand.",
  "Dieses Know-how geben wir gerne an Sie weiter!",
];
---

<section class="section-x flex w-full items-center justify-center gap-1">
  <div
    class="container-wide flex flex-col gap-1 tablet:flex-row tablet:items-start desktop:grid desktop:h-[600px] desktop:grid-cols-4"
  >
    <!-- Portraitkarte -->
    <div
      class="relative flex h-[510px] w-full flex-col items-start justify-between overflow-visible p-[30px] tablet:h-[600px] tablet:flex-1 desktop:col-span-2 desktop:h-full desktop:p-10"
      data-reveal="up"
    >
      <!-- BG -->
      <div
        class="absolute inset-0 z-0 overflow-hidden rounded-[16px] bg-ink desktop:rounded-card"
        aria-hidden="true"
      >
      </div>

      <!-- Portrait: unten rechts verankert, unten ausgeblendet -->
      <img
        src={images.portrait}
        alt="Roger Schüle"
        width="944"
        height="1500"
        loading="lazy"
        class="pointer-events-none absolute right-[18px] bottom-0 z-[1] h-[482px] w-[215px] object-cover object-top tablet:right-[39px] tablet:h-[481px] tablet:w-[78%] desktop:right-[45px] desktop:bottom-[3px] desktop:h-[653px] desktop:w-[403px]"
        style="mask-image:linear-gradient(#000 68%,#0000 100%);-webkit-mask-image:linear-gradient(#000 68%,#0000 100%)"
      />

      <!-- Top -->
      <div class="relative z-[2] flex w-full items-start justify-between">
        <div class="flex w-min flex-col items-start gap-1">
          <p class="t-body whitespace-pre text-white">Roger Schüle</p>
          <p class="t-caption whitespace-pre text-white opacity-60">
            Geschäftsführer<br />Rescue &amp; Safety Academy AG
          </p>
        </div>
        <PlusIcon size={16} bar={2} />
      </div>

      <!-- Bottom -->
      <div
        class="relative z-[2] flex w-full flex-col items-start gap-9 desktop:flex-row desktop:items-end desktop:justify-end desktop:gap-1"
      >
        <p
          class="t-quote w-full text-white desktop:max-w-[290px] desktop:text-right"
        >
          "Ein erfolgreiches Unternehmen muss man mit Leidenschaft aufbauen"
        </p>
      </div>
    </div>

    <!-- Textkarte -->
    <div
      class="flex w-full flex-col items-start justify-start gap-[120px] overflow-hidden rounded-[16px] bg-white p-[30px] tablet:flex-1 tablet:justify-between tablet:gap-8 desktop:col-span-2 desktop:h-full desktop:rounded-card desktop:p-10"
      data-reveal="up"
      style="transition-delay:90ms"
    >
      <div class="flex flex-col gap-6">
        <h2 class="t-h3">Wir stehen für Sicherheit am Arbeitsplatz.</h2>
        <div class="flex flex-col gap-4 opacity-60 desktop:opacity-100">
          {paragraphs.map((text) => <p class="t-body-lg">{text}</p>)}
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <RollButton label="Mehr über RS Academy" href="/ueber-uns" />
        <RollButton
          label={contact.phoneLabel}
          href={contact.phoneHref}
          variant="light"
          class="border border-ink/10"
        />
      </div>
    </div>
  </div>
</section>
