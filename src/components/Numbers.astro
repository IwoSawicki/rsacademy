---
import { numbers } from "../data/site";
---

<section class="section-x w-full pb-10 tablet:pb-[90px] desktop:pb-[100px]">
  <div
    class="container-wide mx-auto grid grid-cols-2 gap-10 tablet:grid-cols-4 tablet:gap-1"
  >
    {
      numbers.map((item) => (
        <div class="flex flex-col gap-2" data-reveal="up">
          <p
            class="text-[40px] font-semibold tablet:text-[58px] desktop:text-[85px]"
            style="letter-spacing:-0.07em"
          >
            <span data-counter={item.value}>0</span>{item.suffix}
          </p>
          <p class="t-body opacity-60">{item.label}</p>
        </div>
      ))
    }
  </div>
</section>
