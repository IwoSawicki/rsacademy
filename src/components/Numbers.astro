---
import { numbers } from "../data/site";
---

<section class="w-full px-5 tablet:px-9">
  <div class="container-wide mx-auto" data-measure="numbers-container">
  <div
    class="grid w-full grid-cols-2 gap-10 pb-10 tablet:grid-cols-4 tablet:gap-1 tablet:pb-[90px] desktop:pb-[100px]"
    data-measure="numbers-grid"
  >
    {
      numbers.map((item) => (
        <div class="flex flex-col items-start gap-2 desktop:gap-[18px]" data-reveal="up" data-measure="numbers-item">
          <p
            class="flex items-center text-[40px] leading-[1.153] font-semibold tablet:text-[58px] desktop:text-[85px]"
            style="letter-spacing:-0.07em"
          >
            <span data-counter={item.value}>0</span>{item.suffix}
          </p>
          <p class="t-body max-w-[140px] text-balance opacity-60">{item.label}</p>
        </div>
      ))
    }
  </div>
  </div>
</section>
