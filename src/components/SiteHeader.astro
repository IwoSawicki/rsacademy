---
import { nav, legal, contact } from "../data/site";
import RollLink from "./RollLink.astro";
import PlusIcon from "./PlusIcon.astro";

/**
 * Kopfzeile mit aufklappendem Menü.
 *
 * Im Original ist der Header selbst der Container: `overflow: hidden`,
 * Innenabstand `19px 36px` geschlossen und `19px 36px 36px` geöffnet.
 * Der Menüblock sitzt geschlossen bei `top:-750px` und rutscht beim Öffnen
 * herunter — kein eigenes Overlay. Der Header wächst dabei mit.
 *
 * Nachgebaut über ein Raster von `0fr` auf `1fr` (animierbare Höhe) und
 * einen `translateY` auf dem Block. Die Menüpunkte blenden gestaffelt ein.
 */
---

<header
  class="fixed top-0 left-0 z-50 flex w-full flex-col justify-between overflow-hidden bg-surface/90 px-5 pt-[19px] backdrop-blur-[7px] transition-[padding] duration-[600ms] ease-[var(--ease-framer)] tablet:px-8 desktop:px-9"
  data-header
>
  <nav class="relative z-[2] flex w-full items-center justify-between">
    <a
      href="/"
      class="text-[14px] leading-[110%] font-semibold whitespace-pre text-ink tablet:text-[20px]"
      style="letter-spacing:-0.04em">Rescue &amp; Safety Academy AG</a
    >

    <!-- Im Original sind Logo, Links und Schalter direkte Geschwister in
         einer Reihe mit `space-between` — kein eigener Block in der Mitte. -->
    {
      nav.slice(1).map((item) => (
        <RollLink
          href={item.href}
          label={item.label}
          distance={40}
          class="hidden text-[16px] leading-[110%] font-semibold text-ink-soft desktop:flex"
        />
      ))
    }

    <button
      type="button"
      id="menu-toggle"
      class="relative z-[3] flex h-[34px] w-[34px] cursor-pointer items-center justify-center"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="menu-body"
    >
      <span class="relative block h-[12px] w-[26px]">
        <span
          class="absolute top-0 left-0 h-[1.5px] w-full bg-ink transition-transform duration-[450ms] ease-[var(--ease-framer)]"
          data-burger-top></span>
        <span
          class="absolute bottom-0 left-0 h-[1.5px] w-full bg-ink transition-transform duration-[450ms] ease-[var(--ease-framer)]"
          data-burger-bottom></span>
      </span>
    </button>
  </nav>

  <!-- Menüblock: Höhe über das Raster animiert -->
  <div
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-[700ms] ease-[var(--ease-framer)]"
    data-menu-shell
  >
    <div class="overflow-hidden">
      <div
        id="menu-body"
        class="flex w-full flex-col items-center gap-[60px] pt-[80px] tablet:gap-[110px] tablet:pt-[130px] desktop:gap-[120px] desktop:pt-[120px]"
        style="transform:translateY(-750px);transition:transform 700ms var(--ease-framer)"
        data-menu-body
      >
        <ul class="flex w-full flex-col items-center gap-1">
          {
            nav.map((item) => (
              <li data-menu-item>
                <RollLink href={item.href} label={item.label} class="t-h1 text-ink" />
              </li>
            ))
          }
        </ul>

        <div data-menu-item>
          <span class="flex items-center gap-2 rounded-[10px] border border-ink/10 bg-white px-4 py-[10px]">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18M12 3a15 15 0 010 18a15 15 0 010-18" />
            </svg>
            <span class="t-body-lg">Deutsch</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </span>
        </div>

        <div
          class="flex w-full flex-col gap-6 desktop:flex-row desktop:items-end desktop:justify-between"
          data-menu-item
        >
          <div class="flex flex-col items-start gap-2">
            <a href={contact.phoneHref} class="t-body-lg hover:opacity-60"
              >{contact.phone}</a
            >
            <span class="flex items-center gap-2">
              <PlusIcon size={14} bar={2} color="#0a0a0a" />
              <a
                href={`mailto:${contact.mailInfo}`}
                class="t-h2 underline underline-offset-[6px] hover:opacity-60"
                >{contact.mailInfo}</a
              >
            </span>
          </div>

          <div class="flex gap-8">
            {
              legal.map((item) => (
                <a href={item.href} class="t-body hover:opacity-60">
                  {item.label}
                </a>
              ))
            }
          </div>

          <p class="t-body opacity-60">© 2026 Search &amp; Rescue Academy AG</p>
        </div>
      </div>
    </div>
  </div>
</header>
