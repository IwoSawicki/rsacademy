---
/** Plus-Glyph aus zwei Balken (Original: "V" + "H"). */
interface Props {
  size?: number;
  bar?: number;
  color?: string;
  class?: string;
}
const {
  size = 16,
  bar = 2,
  color = "#ffffff",
  class: className = "",
} = Astro.props;
const style = `width:${bar}px;height:100%;background-color:${color}`;
const pos = "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2";
---

<span
  class:list={["relative inline-block shrink-0", className]}
  style={`width:${size}px;height:${size}px`}
>
  <span class={pos} style={style}></span>
  <span class:list={[pos, "rotate-90"]} style={style}></span>
</span>
