---
/**
 * Framers "Fit Text": Der Text skaliert mit der Container-Breite.
 * Umgesetzt wie im Original — ein SVG mit viewBox im Seitenverhältnis des
 * Textes; der Text liegt als HTML im foreignObject und skaliert mit.
 *
 * viewBox und fontSize stammen aus `reference/rsacademy.ch/index.html` und
 * dienen als Startwert. `fit-text.ts` misst nach dem Laden der Schrift nach
 * und korrigiert die viewBox, damit der Text exakt anliegt — unabhängig
 * davon, welche Schrift tatsächlich geladen wurde.
 */
interface Props {
  viewBox: string;
  fontSize: number;
  align?: "left" | "right";
  color?: string;
  /** Breite als CSS-Wert (z. B. "43%") — im Original steht sie am Element. */
  width?: string;
  class?: string;
}

const {
  viewBox,
  fontSize,
  align = "left",
  color = "#fff",
  width = "100%",
  class: className = "",
} = Astro.props;
---

<svg
  class:list={["block h-auto", className]}
  style={`width:${width}`}
  viewBox={viewBox}
  role="presentation"
  data-fit-text
>
  <foreignObject width="100%" height="100%" style="overflow:visible">
    <p
      style={`margin:0;display:inline-block;color:${color};font-weight:600;letter-spacing:-0.06em;line-height:120%;white-space:pre;text-align:${align};font-size:${fontSize}px`}
    >
      <slot />
    </p>
  </foreignObject>
</svg>
