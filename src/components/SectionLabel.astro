---
import PlusIcon from "./PlusIcon.astro";
interface Props {
  label: string;
  tone?: "dark" | "light";
}
const { label, tone = "dark" } = Astro.props;
const isDark = tone === "dark";
---

<div
  class:list={[
    "flex w-max items-center gap-2 rounded-pill px-4 py-2",
    isDark ? "bg-ink text-white" : "bg-white text-ink",
  ]}
>
  <PlusIcon size={9} color={isDark ? "#ffffff" : "#0a0a0a"} />
  <span class="t-body">{label}</span>
</div>
